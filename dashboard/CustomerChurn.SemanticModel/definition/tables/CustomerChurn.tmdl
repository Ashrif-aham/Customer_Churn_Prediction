table CustomerChurn
	lineageTag: 28b56b66-bd02-4ccf-8f6b-b4a17b27c785

	measure 'Total Customers' =
			
			DISTINCTCOUNT(CustomerChurn[customerID])
		formatString: #,0
		lineageTag: 913af242-6568-4b05-b54d-2cb0395d81f2

	measure 'Churned Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT(CustomerChurn[customerID]),
			    CustomerChurn[Churn] = "Yes"
			)
		formatString: #,0
		lineageTag: d0e6baf6-5612-4086-aebd-ac88490b0a17

	measure 'Churn Rate' =
			
			DIVIDE([Churned Customers], [Total Customers], 0)
		formatString: 0.00%
		lineageTag: ce1e6b29-259c-4b0e-994a-7fc2155eb51a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Monthly Charge' = AVERAGE(CustomerChurn[MonthlyCharges])
		formatString: #,0.00
		lineageTag: 1f3c0379-324d-4e7d-8a92-49964bac56d7

	measure 'Retained Customers' = CALCULATE([Total Customers], CustomerChurn[Churn] = "No")
		formatString: #,0
		lineageTag: 71d57311-2d93-4f4f-ad2b-fe7781577f9f

	measure 'Average Tenure Months' = AVERAGE(CustomerChurn[tenure])
		formatString: 0.0
		lineageTag: 154c3f54-eb3b-4751-bc44-5bd7f0db1af8


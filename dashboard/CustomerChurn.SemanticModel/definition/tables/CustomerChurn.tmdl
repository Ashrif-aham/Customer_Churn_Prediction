		annotation SummarizationSetBy = Automatic

	partition CustomerChurn = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\user\Downloads\Customer_churn.csv"), [Delimiter=",", Columns=21, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    CleanText = Table.TransformColumns(Headers, List.Transform(Table.ColumnNames(Headers), (c) => {c, each if _ = null then null else Text.Trim(_), type nullable text})),
				    Types = Table.TransformColumnTypes(CleanText, {{"tenure", Int64.Type}, {"SeniorCitizen", Int64.Type}, {"MonthlyCharges", type number}}, "en-US"),
				    TotalCharges = Table.TransformColumns(Types, {{"TotalCharges", each if _ = null or _ = "" then null else Number.FromText(_, "en-US"), type nullable number}}),
				    TenureBand = Table.AddColumn(TotalCharges, "Tenure Band", each if [tenure] = null then "Unknown" else if [tenure] <= 12 then "0–12 months" else if [tenure] <= 24 then "13–24 months" else if [tenure] <= 48 then "25–48 months" else "49+ months", type text),
				    TenureSort = Table.AddColumn(TenureBand, "Tenure Band Sort", each if [tenure] = null then 5 else if [tenure] <= 12 then 1 else if [tenure] <= 24 then 2 else if [tenure] <= 48 then 3 else 4, Int64.Type),
				    SeniorLabel = Table.AddColumn(TenureSort, "Senior Citizen", each if [SeniorCitizen] = 1 then "Yes" else if [SeniorCitizen] = 0 then "No" else "Unknown", type text)
				in
				    SeniorLabel

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

